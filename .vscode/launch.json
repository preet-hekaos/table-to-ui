{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["tableui.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/api",
      "env": {
        "DATABASE_URL": "postgresql+asyncpg://app:app@localhost:5432/tableui",
        "ANALYTICS_DATABASE_URL": "postgresql+asyncpg://app:app@localhost:5432/tableui_analytics",
        "ENVIRONMENT": "local", "MAIL_BACKEND": "smtp", "SMTP_HOST": "localhost", "SMTP_PORT": "1025",
        "PACK_DIR": "${workspaceFolder}/packs/recruitment"
      },
      "justMyCode": false
    }
  ]
}
